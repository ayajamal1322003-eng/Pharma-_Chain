{
  "expo": {
    "name": "PharmaChain",
    "slug": "pharmachain",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0d9488"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pharmachain.mobile"
    },
    "android": {
      "package": "com.pharmachain.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0d9488"
      },
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        { "cameraPermission": "PharmaChain needs camera access to scan QR codes." }
      ]
    ]
  }
}
